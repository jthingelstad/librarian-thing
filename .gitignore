# Dependencies
node_modules/

# Build output
_site/
apps/librarian/lambda/dist/

# Local cache
cache/

# Corpus gate staging (deploy.yml embeds candidates here before upload)
.candidate/

# Environment variables (backups of .env are secrets too)
.env
.env-*
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# OS files
.DS_Store

# Playwright MCP
.playwright-mcp/
test-results/
playwright-report/

# Local Claude settings (project-level skills under .claude/skills/ are committed)
.claude/*
!.claude/skills/

# Pagefind
_site/pagefind/

# SQLite sidecar files
*.db-journal
*.db-wal
*.db-shm

# Local audit/working files
tmp/

# The archive is the library (library.db in S3, see pipeline/library/);
# data/ is the working copy `library.py export` writes, with the corpus and
# graph builds beside it. Never committed since 2026-10-22.
/data/

# Generated pipeline status report (rebuilt by `pipeline/status.py` at
# build time; powers /ops/ and /status.json).
apps/site/_data/status.json

# Generated site inputs — built transiently, handed off to the website repo, never committed here
apps/site/

# The library's local copy (library.db and its ETag; see pipeline/library/)
.library/

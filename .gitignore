# Dependencies
node_modules/

# Build output
_site/
apps/librarian/lambda/dist/

# Local cache
cache/

# Corpus gate staging (deploy.yml embeds candidates here before upload)
.candidate/

# Environment variables (backups of .env are secrets too)
.env
.env-*
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# OS files
.DS_Store

# Playwright MCP
.playwright-mcp/
test-results/
playwright-report/

# Local Claude settings (project-level skills under .claude/skills/ are committed)
.claude/*
!.claude/skills/

# Pagefind
_site/pagefind/

# SQLite sidecar files
*.db-journal
*.db-wal
*.db-shm

# Local audit/working files
tmp/

# Generated librarian artifacts (rebuilt by `make librarian-corpus` and
# `make librarian-graph`; the deploy script regenerates them before upload).
data/librarian/corpus.json
data/librarian/graph.json
data/librarian/podcast_corpus.json
data/librarian/*.embedded.json

# Generated pipeline status report (rebuilt by `pipeline/status.py` at
# build time; powers /ops/ and /status.json).
apps/site/_data/status.json

# Generated site inputs — built transiently, handed off to the website repo, never committed here
apps/site/

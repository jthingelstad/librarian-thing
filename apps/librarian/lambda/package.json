{
  "name": "weekly-thing-librarian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "contract:generate": "node scripts/export-contract.mjs",
    "contract:generate:check": "node scripts/export-contract.mjs --check",
    "mcp-surface:export": "npm run build && node scripts/export-mcp-surface.mjs",
    "mcp-surface:check": "node scripts/export-mcp-surface.mjs --check",
    "format": "prettier --write \"{auth,chat,eval,shared,web,digest}/**/*.mts\" \"scripts/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"{auth,chat,eval,shared,web,digest}/**/*.mts\" \"scripts/**/*.mjs\" \"*.json\"",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run contract:generate:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run mcp-surface:check",
    "golden": "node scripts/golden-live.mjs",
    "eval:tools": "node scripts/eval-tools.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1090.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@aws-sdk/client-cloudformation": "^3.1151.0",
    "@aws-sdk/client-cloudfront": "^3.1151.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1151.0",
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-lambda-web": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-secrets-manager": "^3.1145.0",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "@hono/node-server": "^2.1.5",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@streamparser/json": "^0.0.26",
    "hono": "^4.13.13",
    "markdown-it": "^14.3.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}

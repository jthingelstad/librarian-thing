# Local .env for librarian-thing. Names only; never commit values.
# CI does not read this file: deploy.yml and the sync workflow take their
# secrets from GitHub Actions and their AWS credentials from OIDC.

# AWS: local tools use the operator profile. Do not store AWS keys here.
AWS_PROFILE=
AWS_DEFAULT_REGION=

# Pipeline LLM work (blog alt text and typo scans, media descriptions, audits).
ANTHROPIC_GENERAL_API_KEY=

# Micro.blog Micropub, for blog ingest and maintenance scripts.
MICROBLOG_API_KEY=

# Copies of runtime-secret values for local tools only; a deploy carries no
# credentials (the Lambdas read the hand-kept weekly-thing-librarian-runtime
# secret). LIBRARIAN_RETRIEVE_SECRET: quality-bench.mjs and golden-retrieval.
# THINGY_WEB_ORIGIN_TOKEN: the Thingy web dev server's /api proxy.
LIBRARIAN_RETRIEVE_SECRET=
THINGY_WEB_ORIGIN_TOKEN=

# Written by pipeline/deploy/aws.py from the stack outputs after a local deploy.
LIBRARIAN_API_URL=
LIBRARIAN_STREAM_URL=

# Graph upload target for `make librarian-graph-upload`.
AWS_S3_BUCKET=

# Fine-grained PAT (Contents: write on weekly.thingelstad.com) for the
# graph.json handoff in pipeline/deploy/push_graph.py.
GITHUB_PAT_TOKEN=

# Optional overrides are listed in reference/librarian.md.

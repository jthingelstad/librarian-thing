# Discord assistant token
DISCORD_TOKEN_EDDY=

# Discord server and channel IDs
DISCORD_SERVER_ID=
DISCORD_WORKSHOP_CATEGORY_ID=
DISCORD_OWNER_USER_ID=
DISCORD_CHANNEL_EDITORIAL=
DISCORD_CHANNEL_WORKSHOP=
DISCORD_CHANNEL_CHATTER=

# Anthropic API keys by billing purpose
ANTHROPIC_EDDY_API_KEY=
ANTHROPIC_GENERAL_API_KEY=

# Model/runtime configuration
WORKSHOP_DEFAULT_MODEL=haiku
WORKSHOP_EDDY_REVIEW_MODEL=
WORKSHOP_SCHEDULER_ENABLED=1
WORKSHOP_DB_PATH=
WORKSHOP_LOG_LEVEL=INFO
WORKSHOP_ALT_VISION_CAP=15

# Private web app (tailnet-only via `tailscale serve`; in-process inside the bot)
WORKSHOP_WEBAPP_PORT=8770              # loopback port; tailscale serve maps :8443 → here
TAILSCALE_ALLOWED_LOGIN=jthingelstad@github   # only this Tailscale identity may load the app

# Publishing and integrations
BUTTONDOWN_API_KEY=
TINYLYTICS_API_KEY=
TINYLYTICS_SITE_UID=
PINBOARD_API_TOKEN=
STRIPE_API_KEY=
MICROBLOG_API_KEY=
OPENAI_API_KEY=
LIBRARIAN_RETRIEVE_SECRET=

# Local AWS tools use an active operator profile; do not store AWS keys here.
# GitHub deployments obtain temporary credentials through OIDC independently.
AWS_PROFILE=jamie
AWS_DEFAULT_REGION=us-east-1
WEEKLY_THING_ASSETS_BUCKET=files.thingelstad.com

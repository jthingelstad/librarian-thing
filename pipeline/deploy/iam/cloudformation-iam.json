{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LibrarianFunctionRoleReadAndMaintain",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-LibrarianFunctionRole-*"
    },
    {
      "Sid": "LibrarianFunctionRoleBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-LibrarianFunctionRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::999153317627:policy/WeeklyThingLibrarianRuntimeBoundary"
        }
      }
    },
    {
      "Sid": "LibrarianFunctionRolePass",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-LibrarianFunctionRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "BedrockEvaluationRoleReadAndMaintain",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-BedrockEvaluationRole-*"
    },
    {
      "Sid": "BedrockEvaluationRoleBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-BedrockEvaluationRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::999153317627:policy/WeeklyThingLibrarianEvaluationBoundary"
        }
      }
    },
    {
      "Sid": "BedrockEvaluationRolePass",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-BedrockEvaluationRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock.amazonaws.com"
        }
      }
    },
    {
      "Sid": "LambdaLoggingPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::999153317627:role/weekly-thing-librarian-LibrarianFunctionRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "InspectApplicationPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
        "arn:aws:iam::999153317627:policy/WeeklyThingLibrarianRuntimeBoundary",
        "arn:aws:iam::999153317627:policy/WeeklyThingLibrarianEvaluationBoundary"
      ]
    }
  ]
}
